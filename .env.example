# Local-only defaults. Copy this file to .env before running Docker Compose.

# Postgres / PostGIS
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_EXTERNAL_PORT=5433
POSTGRES_DB=event_discovery
POSTGRES_USER=event_discovery
POSTGRES_PASSWORD=change-me-for-nonlocal-use
SEED_DATABASE=true

# Neo4j: disposable graph projection; all source data remains in Postgres.
NEO4J_IMAGE=neo4j:5.26-community
NEO4J_BIND_ADDRESS=127.0.0.1
NEO4J_HTTP_EXTERNAL_PORT=7474
NEO4J_BOLT_EXTERNAL_PORT=7687
NEO4J_URI=bolt://neo4j:7687
NEO4J_DATABASE=neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-for-nonlocal-use
NEO4J_PROJECTION_DAG_SCHEDULE="30 * * * *"

# Airflow
AIRFLOW_VERSION=3.3.1
AIRFLOW_DB=airflow
AIRFLOW_BIND_ADDRESS=127.0.0.1
AIRFLOW_HOST=airflow-api-server
AIRFLOW_PORT=8080
AIRFLOW_EXTERNAL_PORT=8080
AIRFLOW_JWT_SECRET=replace-with-a-long-random-value

# Eventbrite public discovery plus official per-event detail API.
# Markets and source-native location/category/window/page-cap rows live in Postgres.
EVENTBRITE_API_BASE_URL=https://www.eventbriteapi.com/v3
EVENTBRITE_WEB_BASE_URL=https://www.eventbrite.com
EVENTBRITE_API_TOKEN=
EVENTBRITE_DETAIL_CACHE_TTL_HOURS=24
EVENTBRITE_DAG_SCHEDULE="15 3 * * *"
EVENTBRITE_REQUEST_TIMEOUT_SECONDS=30

# Official Meetup GraphQL discovery API.
# Coordinates/radii and topic categories live in ingest.crawl_target, not here.
MEETUP_API_URL=https://api.meetup.com/gql-ext
MEETUP_ACCESS_TOKEN=
MEETUP_DAG_SCHEDULE="0 3 * * *"
MEETUP_PAGE_SIZE=20
MEETUP_REQUEST_TIMEOUT_SECONDS=30

# Dedup embeddings. Vectors live in Postgres via pgvector, so there is no vector service here.
# The dimension is not configurable: it is the source_listing.embedding column type,
# vector(1536), owned by the migration. Changing model family is a migration plus a re-embed.
DEDUP_DAG_SCHEDULE="15 * * * *"
DEDUP_SOURCE_PRIORITY=eventbrite,meetup
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=100
EMBEDDING_REQUEST_TIMEOUT_SECONDS=30

# Server-side Google Geocoding v4 (use a separate, restricted web-service key)
GOOGLE_GEOCODING_API_BASE_URL=https://geocode.googleapis.com/v4/geocode/address
GOOGLE_GEOCODING_API_KEY=
GOOGLE_GEOCODING_DAG_SCHEDULE="0 * * * *"
GOOGLE_GEOCODING_REGION_CODE=US
GOOGLE_GEOCODING_LANGUAGE_CODE=en
GOOGLE_GEOCODING_TIMEOUT_SECONDS=10

# FastAPI
# Admin review is disabled until both are set. See docs/dedup-review.md.
ADMIN_REVIEW_TOKEN=
ADMIN_REVIEW_USER_ID=
API_DB_STARTUP_ATTEMPTS=30
API_DB_STARTUP_RETRY_SECONDS=1
API_BIND_ADDRESS=127.0.0.1
API_HOST=0.0.0.0
API_PORT=8000
API_EXTERNAL_PORT=8000
PUBLIC_API_BASE_URL=http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
VITE_PROXY_API_TARGET=http://api:8000

# React
WEB_BIND_ADDRESS=127.0.0.1
WEB_HOST=0.0.0.0
WEB_PORT=3000
WEB_EXTERNAL_PORT=3000
PUBLIC_WEB_BASE_URL=http://127.0.0.1:3000
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Services introduced in later phases
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
